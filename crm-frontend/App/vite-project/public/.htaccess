# Apache SPA fallback for hr.profenaa.com
#
# Without this, refreshing (or directly opening a link to) any client-side route like
# /admin/dashboard or /user/dashboard sends a real request to the server for a file that
# does not exist on disk, and Apache correctly returns a genuine 404 - React Router never
# even gets a chance to handle it. This rewrites every request that is NOT a real file or
# folder back to index.html, so React Router loads first and then takes over routing.
#
# Place this file at the WEB ROOT of the deployed frontend (the same folder as
# index.html) - typically public_html or public_html/<subfolder> on Hostinger. If one
# already exists there, merge this RewriteEngine block into it rather than replacing the
# whole file, in case it already does something else you need.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let real files and folders (JS, CSS, images, etc.) load normally
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else falls back to index.html so React Router can handle it
  RewriteRule ^ index.html [L]
</IfModule>
