# ---- Database (local MongoDB, the same one you open in Compass) ----
# Replace YOURDBNAME with your CRM database name.
MONGO_URI=mongodb://localhost:27017/Profenaa_staff crm
PORT=8000

# ---- Security (optional for local use) ----
# Leave these two lines commented out to keep the built-in defaults, so existing
# logins keep working. For a public server, uncomment and set long random values
# (this logs everyone out once).
# JWT_SECRET=change-me-employee-secret
# ADMIN_JWT_SECRET=change-me-admin-secret

# ---- Optional ----
# Comma separated list of frontend origins allowed for real-time (Socket.IO)
# CORS_ORIGIN=http://localhost:5173
# How often the attendance monitor sweeps (milliseconds)
# MONITOR_INTERVAL_MS=15000

# Office-network check for CRM login.
# Only needed when the API runs BEHIND a proxy (nginx, a cloud load balancer):
# set the number of proxies in front of it (usually 1) so the real client address is used.
# Leave it out when the API is reached directly.
# TRUST_PROXY=1
